  "source": "Synthetic: a Sentinel-5P-shaped NetCDF-4 file written by h5wasm in Node with the PRODUCT paths, attributes, dtypes and chunking of the offline NO2 file read on 2026-11-05. No Copernicus data.",
  "declaredParameters": {
    "file": "sample-satellite-s5p-001.nc",
    "paths": {
      "value": "PRODUCT/nitrogendioxide_tropospheric_column",
      "latitude": "PRODUCT/latitude",
      "longitude": "PRODUCT/longitude",
      "quality": "PRODUCT/qa_value",
      "time": "PRODUCT/time_utc"
    },
    "from": "2023-06-07",
    "until": "2023-06-08",
    "fileDate": "2023-06-07",
    "fileDatetime": "2023-06-07T17:24:00Z",
    "stream": "OFFL",
    "orbit": 29273,
    "pixel": {
      "rule": "the pixel whose centre is nearest the point, among centres with |lat| <= 90 and |lon| <= 180",
      "distance": "sqrt(((lon - lon_c) * cos(lat of the point))^2 + (lat - lat_c)^2), in degrees",
      "offSwath": "no pixel when that distance exceeds max(1.5 x half the distance from the centre to its nearest of the four neighbouring centres, measured the same way with cos(lat of the centre), 0.01 degrees)"
    },
    "fill": {
      "value": "values at or above 9e+36 are no retrieval",
      "quality": "a qa_value stored as 255 is no retrieval"
    },
    "quality": {
      "threshold": 0.75,
      "compare": "the stored integer against round(threshold / scale_factor)",
      "operators": [
        ">=",
        ">"
      ]
    },
    "table": "one row per point per file read, and one per point per day with no file, gap \"no overpass\" and nothing else filled. A point the file does not cover is \"no overpass\" too, with the file's own time, stream and orbit, so the row says which file was looked at. The value is kept only where it passed; qa_value is the stored integer times the scale factor, to 2 decimals, empty where it is the fill"
  },
